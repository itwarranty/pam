# MT Bastion — правила auditd на хосте (дополнение к логам внутри контейнера)

-w {{ audit_log_dir }} -p wa -k mt_bastion_session_logs
{% if bastion_break_glass_audit_enabled | default(true) | bool %}
-w {{ audit_log_dir }} -p wa -k mt_bastion_break_glass_session
{% endif %}

-a always,exit -F arch=b64 -S connect -F a2=16 -k mt_bastion_ssh_connect
-a always,exit -F arch=b32 -S connect -F a2=16 -k mt_bastion_ssh_connect
