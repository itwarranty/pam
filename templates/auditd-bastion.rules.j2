# SSH PAM — правила auditd на хосте (дополнение к логам внутри контейнера)

-w {{ audit_log_dir }} -p wa -k bastion_session_logs
{% if bastion_break_glass_audit_enabled | default(true) | bool %}
-w {{ audit_log_dir }} -p wa -k bastion_break_glass_session
{% endif %}

-a always,exit -F arch=b64 -S connect -F a2=16 -k bastion_ssh_connect
{% if bastion_gateway_audit_target_keys | default(true) | bool and bastion_targets | default([]) | length > 0 %}
-w {{ bastion_targets_home }} -p r -k bastion_target_key_read
{% endif %}
-a always,exit -F arch=b32 -S connect -F a2=16 -k bastion_ssh_connect
