Port {{ pam_ssh_port }}
Protocol 2
PasswordAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
UsePAM yes

# Блокировка неаудируемых каналов
X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no

# Jump-host: контролируемый TCP-forwarding вместо полного запрета
AllowTcpForwarding {{ 'yes' if pam_allow_tcp_forwarding | bool else 'no' }}
{% if pam_allow_tcp_forwarding | bool and pam_permitted_targets | length > 0 %}
{%   for target in pam_permitted_targets %}
PermitOpen {{ target }}
{%   endfor %}
{% endif %}

ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE
SyslogFacility AUTH
Banner /etc/ssh/gateway-banner.txt

{% if pam_mfa_mode | default('totp') == 'fido_only' and pam_fido_only_waiver | default(false) | bool and pam_require_fido_pubkey | default(false) | bool %}
# MFA fido_only (CSO waiver): FIDO-sk pubkey/cert only — no TOTP prompt
KbdInteractiveAuthentication no
AuthenticationMethods publickey
{% else %}
# MFA: pubkey/cert + TOTP (PAM google-authenticator внутри образа)
KbdInteractiveAuthentication yes
AuthenticationMethods publickey,keyboard-interactive
{% endif %}

{% if pam_trusted_user_ca_file | default('') | length > 0 %}
# User certificates, подписанные CA организации (например *.example.com)
TrustedUserCAKeys /etc/ssh/trusted_user_ca.pub
{% endif %}

{% for operator in pam_operators_effective | default(pam_operators) %}
Match User {{ operator.name }}
{%   if operator.break_glass | default(false) | bool %}
    SetEnv PAM_BREAK_GLASS=1
{%   endif %}
{%   if operator.incident_id | default('') | length > 0 %}
    SetEnv PAM_INCIDENT_ID={{ operator.incident_id }}
{%   endif %}
{%   if operator.name in (pam_dr_service_operators | default([])) %}
    AuthenticationMethods publickey
{%   endif %}
{%   if operator.access | default('jump') == 'audit' %}
    ForceCommand /usr/local/bin/pam-audit-shell-wrapper.sh
    AllowTcpForwarding no
{%   elif operator.access | default('jump') == 'shell' %}
    ForceCommand /usr/local/bin/pam-shell-wrapper.sh
    AllowTcpForwarding no
{%   elif operator.access | default('jump') == 'gateway' %}
    ForceCommand /usr/local/bin/pam-ssh-gateway-wrapper.sh
    AllowTcpForwarding no
{%   else %}
    # Jump: restrict in authorized_keys; help on mistaken interactive login
    PermitTTY no
    ForceCommand /usr/local/bin/pam-jump-help-wrapper.sh
    AllowTcpForwarding {{ 'local' if pam_allow_tcp_forwarding | bool else 'no' }}
{%     if operator.permit_open | default([]) | length > 0 %}
{%       for target in operator.permit_open %}
    PermitOpen {{ target }}
{%       endfor %}
{%     endif %}
{%   endif %}
{% endfor %}
