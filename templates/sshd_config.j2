Port {{ bastion_ssh_port }}
Protocol 2
PasswordAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
UsePAM yes

# Блокировка неаудируемых каналов
X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no

# Jump-host: контролируемый TCP-forwarding вместо полного запрета
AllowTcpForwarding {{ 'yes' if bastion_allow_tcp_forwarding | bool else 'no' }}
{% if bastion_allow_tcp_forwarding | bool and bastion_permitted_targets | length > 0 %}
{%   for target in bastion_permitted_targets %}
PermitOpen {{ target }}
{%   endfor %}
{% endif %}

ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE
SyslogFacility AUTH

{% if bastion_mfa_mode | default('totp') == 'fido_only' and bastion_fido_only_waiver | default(false) | bool and bastion_require_fido_pubkey | default(false) | bool %}
# MFA fido_only (CSO waiver): FIDO-sk pubkey/cert only — no TOTP prompt
KbdInteractiveAuthentication no
AuthenticationMethods publickey
{% else %}
# MFA: pubkey/cert + TOTP (PAM google-authenticator внутри образа)
KbdInteractiveAuthentication yes
AuthenticationMethods publickey,keyboard-interactive
{% endif %}

{% if bastion_trusted_user_ca_file | default('') | length > 0 %}
# User certificates, подписанные CA организации (например *.mtglobal.team)
TrustedUserCAKeys /etc/ssh/trusted_user_ca.pub
{% endif %}

{% for operator in bastion_operators_effective | default(bastion_operators) %}
Match User {{ operator.name }}
{%   if operator.break_glass | default(false) | bool %}
    SetEnv MT_BASTION_BREAK_GLASS=1
{%   endif %}
{%   if operator.incident_id | default('') | length > 0 %}
    SetEnv MT_BASTION_INCIDENT_ID={{ operator.incident_id }}
{%   endif %}
{%   if operator.access | default('jump') == 'audit' %}
    ForceCommand /usr/local/bin/bastion-audit-shell-wrapper.sh
    AllowTcpForwarding no
{%   elif operator.access | default('jump') == 'shell' %}
    ForceCommand /usr/local/bin/bastion-shell-wrapper.sh
    AllowTcpForwarding no
{%   elif operator.access | default('jump') == 'gateway' %}
    ForceCommand /usr/local/bin/bastion-ssh-gateway-wrapper.sh
    AllowTcpForwarding no
{%   else %}
    # Jump: shell заблокирован через restrict в authorized_keys; только port-forwarding
    AllowTcpForwarding {{ 'local' if bastion_allow_tcp_forwarding | bool else 'no' }}
{%     if operator.permit_open | default([]) | length > 0 %}
{%       for target in operator.permit_open %}
    PermitOpen {{ target }}
{%       endfor %}
{%     endif %}
{%   endif %}
{% endfor %}
