---
#  internal prod profile (v1.0 GA) — copy/adapt with Vault.
# CSO: command policy v2 mandatory (do not disable without pam_command_policy_v2_required: false + risk acceptance).

pam_prod_require_gateway: true
pam_jit_timer_enabled: true
pam_siem_forward_enabled: true
pam_require_source_ip: true
pam_shell_command_policy_enabled: true
pam_command_policy_v2_required: true
pam_gateway_command_policy_v2_enabled: true
pam_shell_command_policy_v2_enabled: true
pam_session_search_enabled: true
pam_session_watch_enabled: true
pam_ssh_user_ca_qa_complete: true  # after internal PKI sign-off

# Tier 5 FIDO-Anchor MFA (recommended prod)
pam_require_fido_pubkey: true
pam_mfa_mode: fido_totp

# pam_vault_enabled: true
# pam_vault_addr: "https://vault.internal.example"
# pam_oidc_cert_policy_enabled: true

# Internal prod acceptance (OpenSpec tasks §10 — org gate):
# - gateway session recorded; pam-session-search finds by operator + date
# - policy v2 denies destructive command on target
# - pam-session-watch on live session; kill + JIT purge still work
# - pam-compliance-verify.sh exit 0
# - OIDC-signed or internal CA cert login for one operator
# - HA tabletop per docs/HA-Runbook.md
