---
# MT Global internal prod profile (v1.0 GA) — copy/adapt with Vault.

bastion_prod_require_gateway: true
bastion_jit_timer_enabled: true
bastion_siem_forward_enabled: true
bastion_require_source_ip: true
bastion_gateway_command_policy_v2_enabled: true
bastion_shell_command_policy_v2_enabled: true
bastion_session_search_enabled: true
bastion_session_watch_enabled: true
bastion_ssh_user_ca_qa_complete: true  # after internal PKI sign-off

# Tier 5 FIDO-Anchor MFA (recommended prod)
bastion_require_fido_pubkey: true
bastion_mfa_mode: fido_totp

# bastion_vault_enabled: true
# bastion_vault_addr: "https://vault.internal.example"
# bastion_oidc_cert_policy_enabled: true

# Internal prod acceptance (OpenSpec tasks §10 — org gate):
# - gateway session recorded; bastion-session-search finds by operator + date
# - policy v2 denies destructive command on target
# - bastion-session-watch on live session; kill + JIT purge still work
# - bastion-compliance-verify.sh exit 0
# - OIDC-signed or internal CA cert login for one operator
# - HA tabletop per docs/MT-Bastion-HA-Runbook.md
