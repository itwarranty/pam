# MT: Bastion — декларативный манифест сборки для ИБ-аудита.
# Сборка один раз на build-машине; при старте контейнера пакеты не скачиваются.

FROM docker.io/library/alpine:3.19

ARG MFA_STRICT=1

LABEL org.opencontainers.image.title="MT Bastion Secure"
LABEL org.opencontainers.image.vendor="MT Global"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL mt.global.mfa.strict="${MFA_STRICT}"

RUN apk add --no-cache \
      openssh \
      openssh-keygen \
      openssh-server-pam \
      python3 \
      google-authenticator \
      tmux \
      bash \
      util-linux \
      shadow \
      e2fsprogs \
    && mkdir -p /var/empty/sshd /var/log/bastion_sessions \
    && ssh-keygen -A

COPY build/files/bastion-shell-wrapper.sh /usr/local/bin/bastion-shell-wrapper.sh
COPY build/files/bastion-entrypoint.sh /usr/local/bin/bastion-entrypoint.sh
COPY build/files/bastion-command-policy.sh /usr/local/bin/bastion-command-policy.sh
COPY build/files/bastion-command-policy-rc.sh /usr/local/bin/bastion-command-policy-rc.sh
COPY build/files/bastion-audit-shell-wrapper.sh /usr/local/bin/bastion-audit-shell-wrapper.sh
COPY build/files/bastion-audit-shell.sh /usr/local/bin/bastion-audit-shell.sh
COPY build/files/bastion-ssh-gateway-wrapper.sh /usr/local/bin/bastion-ssh-gateway-wrapper.sh
COPY build/files/bastion-ssh-gateway.sh /usr/local/bin/bastion-ssh-gateway.sh
COPY build/files/bastion-ssh-gateway-exec.sh /usr/local/bin/bastion-ssh-gateway-exec.sh
COPY build/files/bastion-session-ctl-internal.sh /usr/local/bin/bastion-session-ctl-internal.sh
COPY build/files/bastion-pty-inspector.py /usr/local/bin/bastion-pty-inspector.py
COPY build/files/bastion-pty-inspector.sh /usr/local/bin/bastion-pty-inspector.sh

RUN mkdir -p /run/mt-bastion/sessions \
    && chmod 0755 /usr/local/bin/bastion-shell-wrapper.sh /usr/local/bin/bastion-entrypoint.sh \
    /usr/local/bin/bastion-command-policy.sh /usr/local/bin/bastion-command-policy-rc.sh \
    /usr/local/bin/bastion-audit-shell-wrapper.sh /usr/local/bin/bastion-audit-shell.sh \
    /usr/local/bin/bastion-ssh-gateway-wrapper.sh /usr/local/bin/bastion-ssh-gateway.sh \
    /usr/local/bin/bastion-ssh-gateway-exec.sh /usr/local/bin/bastion-session-ctl-internal.sh \
    /usr/local/bin/bastion-pty-inspector.py /usr/local/bin/bastion-pty-inspector.sh \
    && if [ "${MFA_STRICT}" = "1" ]; then \
         printf '%s\n' '#%PAM-1.0' \
           'auth required pam_google_authenticator.so' \
           'account include base-account' \
           'password include base-password' \
           'session include base-session' \
           > /etc/pam.d/sshd; \
       else \
         printf '%s\n' '#%PAM-1.0' \
           'auth required pam_google_authenticator.so nullok' \
           'account include base-account' \
           'password include base-password' \
           'session include base-session' \
           > /etc/pam.d/sshd; \
       fi

EXPOSE 2222

ENTRYPOINT ["/usr/local/bin/bastion-entrypoint.sh"]
