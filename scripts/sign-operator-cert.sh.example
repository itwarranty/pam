#!/usr/bin/env bash
# SSH PAM — offline SSH user certificate signing (EXAMPLE).
# Private User CA key NEVER on bastion — run on admin workstation / HSM jump.
#
# Usage:
#   export BASTION_USER_CA_KEY=/secure/path/user-ca
#   ./scripts/sign-operator-cert.sh.example engineer-jump ~/.ssh/engineer-jump.key 72
#   ./scripts/sign-operator-cert.sh.example engineer-jump ~/.ssh/engineer-jump.key 72 2026-12-31T23:59:59Z

set -euo pipefail

NAME="${1:?operator name (Unix account)}"
PRIV="${2:?path to operator private key}"
HOURS="${3:-72}"
VALID_UNTIL="${4:-}"
DOMAIN="${BASTION_CERT_DOMAIN:-example.com}"
CA_KEY="${BASTION_USER_CA_KEY:?set BASTION_USER_CA_KEY to User CA private key path}"
MAX_HOURS="${BASTION_CERT_MAX_VALIDITY_HOURS:-72}"

if [[ -n "${VALID_UNTIL}" ]]; then
  VALIDITY="-1d:${VALID_UNTIL}"
  printf '[sign-operator-cert] JIT window validity: %s\n' "${VALIDITY}" >&2
else
  [[ "${HOURS}" -le "${MAX_HOURS}" ]] || printf '[sign-operator-cert] WARN: %sh > %sh CSO default\n' "${HOURS}" "${MAX_HOURS}" >&2
  VALIDITY="+${HOURS}h"
fi

PUB="${PRIV}.pub"
[[ -f "${PUB}" ]] || ssh-keygen -y -f "${PRIV}" > "${PUB}"

OUT="$(dirname "${PRIV}")/${NAME}-cert.pub"

ssh-keygen -s "${CA_KEY}" -I "${NAME}@${DOMAIN}" -n "${NAME}" -V "${VALIDITY}" \
  -z "$(date +%s)" "${PUB}"
mv -f "${PUB}-cert.pub" "${OUT}"

printf '[sign-operator-cert] %s (validity %s)\n' "${OUT}" "${VALIDITY}"
printf 'Ansible: certificate: "{{ lookup('"'"'file'"'"', playbook_dir + '"'"'/lab/certs/%s'"'"') }}"\n' "${NAME}-cert.pub"
