#!/usr/bin/env bash
# SSH PAM — host-side JIT purge wrapper (copy to gateway, adjust paths).
# Installed by Ansible as {{ bastion_jit_purge_script_path }} when bastion_jit_timer_enabled.
#
# Prerequisites on bastion host:
#   - ansible-playbook, repo at /opt/pam (or set BASTION_ROOT)
#   - inventory/hosts.yml with prod operators
#
# Manual run:
#   ./scripts/jit-purge-host.sh.example

set -euo pipefail

ROOT="${BASTION_ROOT:-/opt/pam}"
INV="${BASTION_INVENTORY:-${ROOT}/inventory/hosts.yml}"

exec ansible-playbook -i "${INV}" "${ROOT}/site.yml" --tags jit_purge "$@"
